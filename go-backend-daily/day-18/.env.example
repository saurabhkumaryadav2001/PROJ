# Local development only. Replace the secret before any deployment.
APP_ENV=development
HTTP_ADDR=:8080
JWT_SECRET=local-development-only-secret-change-before-deploy-2026
JWT_ISSUER=go-backend-daily
JWT_AUDIENCE=go-backend-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
PASSWORD_ITERATIONS=600000

# Optional: set both values to bootstrap a local admin.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
